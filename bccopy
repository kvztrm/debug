local function getMyPlate()
    if not Workspace:FindFirstChild("Plates") then return nil end
    for i = 1, 9 do
        local plate = Workspace.Plates:FindFirstChild("Plate" .. i)
        if plate and plate:FindFirstChild("Owner") then
            if tostring(plate.Owner.Value) == LocalPlayer.Name then
                return plate
            end
        end
    end
    return nil
end

-- Groups parts data into discrete Y layers (within SNAP tolerance).
-- Returns an array of layers, each layer is an array of parts,
-- sorted within the layer by distance from XZ center (center-outward).
local LAYER_SNAP = 0.5 -- studs — Y values within this are the same layer

local function groupIntoLayers(partsData, srcPivotX, srcPivotZ)
    local layers = {}
    local layerMap = {}

    for _, data in ipairs(partsData) do
        local y = data.CFrame.Y
        local foundKey = nil

        for key, _ in pairs(layerMap) do
            if math.abs(y - key) <= LAYER_SNAP then
                foundKey = key
                break
            end
        end

        if not foundKey then
            foundKey = y
            layerMap[foundKey] = {}
        end

        table.insert(layerMap[foundKey], data)
    end

    -- Collect and sort layers by Y ascending
    local sortedKeys = {}
    for key, _ in pairs(layerMap) do
        table.insert(sortedKeys, key)
    end
    table.sort(sortedKeys)

    for _, key in ipairs(sortedKeys) do
        local layer = layerMap[key]

        -- Within each layer: sort center-outward so each block
        -- lands adjacent to the previous one, never isolated in air
        table.sort(layer, function(a, b)
            local adx = a.CFrame.X - srcPivotX
            local adz = a.CFrame.Z - srcPivotZ
            local bdx = b.CFrame.X - srcPivotX
            local bdz = b.CFrame.Z - srcPivotZ
            return (adx*adx + adz*adz) < (bdx*bdx + bdz*bdz)
        end)

        table.insert(layers, layer)
    end

    return layers
end

