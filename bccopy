local GRID = 2  -- resolution in studs

local function occupancyKey(x, y, z)
    return math.round(x / GRID) .. "," .. math.round(y / GRID) .. "," .. math.round(z / GRID)
end

-- Mark every grid cell the block physically occupies, based on its
-- world-space CFrame and size. This is the core fix — adjacency checks
-- now find populated face cells, not just the center.
local function markFootprint(cx, cy, cz, sizeX, sizeY, sizeZ, occupied)
    local hx = math.max(sizeX / 2, GRID)
    local hy = math.max(sizeY / 2, GRID)
    local hz = math.max(sizeZ / 2, GRID)

    local x = cx - hx
    while x <= cx + hx + 0.01 do
        local y = cy - hy
        while y <= cy + hy + 0.01 do
            local z = cz - hz
            while z <= cz + hz + 0.01 do
                occupied[occupancyKey(x, y, z)] = true
                z = z + GRID
            end
            y = y + GRID
        end
        x = x + GRID
    end
end

-- 6-face neighbors only — with full footprint marking, 6-face is
-- sufficient and cheaper than 26-connectivity.
local NEIGHBOR_OFFSETS = {
    Vector3.new( GRID,  0,    0   ),
    Vector3.new(-GRID,  0,    0   ),
    Vector3.new( 0,     GRID, 0   ),
    Vector3.new( 0,    -GRID, 0   ),
    Vector3.new( 0,     0,    GRID),
    Vector3.new( 0,     0,   -GRID),
}

local function hasNeighbor(cx, cy, cz, sizeX, sizeY, sizeZ, occupied)
    -- Check every face cell of this block's footprint for an occupied neighbor.
    -- A neighbor exists if any cell just outside any face is occupied.
    local hx = math.max(sizeX / 2, GRID)
    local hy = math.max(sizeY / 2, GRID)
    local hz = math.max(sizeZ / 2, GRID)

    -- Sample face centers + corners on each of the 6 faces
    local faces = {
        -- +X face
        {cx + hx + GRID, cy, cz},
        -- -X face
        {cx - hx - GRID, cy, cz},
        -- +Y face
        {cx, cy + hy + GRID, cz},
        -- -Y face (ground connection)
        {cx, cy - hy - GRID, cz},
        -- +Z face
        {cx, cy, cz + hz + GRID},
        -- -Z face
        {cx, cy, cz - hz - GRID},
    }

    for _, f in ipairs(faces) do
        if occupied[occupancyKey(f[1], f[2], f[3])] then
            return true
        end
    end

    return false
end

local function neighborCount(cx, cy, cz, sizeX, sizeY, sizeZ, occupied)
    local count = 0
    local hx = math.max(sizeX / 2, GRID)
    local hy = math.max(sizeY / 2, GRID)
    local hz = math.max(sizeZ / 2, GRID)
    local faces = {
        {cx + hx + GRID, cy, cz},
        {cx - hx - GRID, cy, cz},
        {cx, cy + hy + GRID, cz},
        {cx, cy - hy - GRID, cz},
        {cx, cy, cz + hz + GRID},
        {cx, cy, cz - hz - GRID},
    }
    for _, f in ipairs(faces) do
        if occupied[occupancyKey(f[1], f[2], f[3])] then
            count = count + 1
        end
    end
    return count
end

-- Read block size from source model. Falls back to 4x4x4 if no part found.
local function getModelSize(model)
    local part = model.PrimaryPart
    if not part then
        for _, c in ipairs(model:GetChildren()) do
            if c:IsA("BasePart") then part = c; break end
        end
    end
    if part then
        return part.Size.X, part.Size.Y, part.Size.Z
    end
    return 4, 4, 4  -- standard block fallback
end

local function getLargestBase(plate)
    local bestArea, bestPart = 0, nil
    for _, part in ipairs(plate:GetDescendants()) do
        if part:IsA("BasePart") and part.Size.X > 10 and part.Size.Z > 10 then
            local area = part.Size.X * part.Size.Z
            if area > bestArea then bestArea = area; bestPart = part end
        end
    end
    return bestPart
end

local function getMyPlate()
    if not Workspace:FindFirstChild("Plates") then return nil end
    for i = 1, 9 do
        local plate = Workspace.Plates:FindFirstChild("Plate" .. i)
        if plate and plate:FindFirstChild("Owner") then
            if tostring(plate.Owner.Value) == LocalPlayer.Name then
                return plate
            end
        end
    end
    return nil
end

