Tab:CreateButton({
    Name = "Mirror & Build (Footprint BFS)",
    Callback = function()
        if not selectedPlotName
            or selectedPlotName == "Scanning..."
            or selectedPlotName == "No Available Plots" then
            Rayfield:Notify({Title = "Error", Content = "Please select a valid plot first!", Duration = 3})
            return
        end

        local plateNum    = selectedPlotName:match("Plate%s*(%d)")
        local sourcePlate = plateNum
            and Workspace:FindFirstChild("Plates")
            and Workspace.Plates:FindFirstChild("Plate" .. plateNum)
        local myPlate = getMyPlate()

        if not sourcePlate or not sourcePlate:FindFirstChild("ActiveParts") then
            Rayfield:Notify({Title = "Error", Content = "Source ActiveParts not found!", Duration = 3})
            return
        end
        if not myPlate then
            Rayfield:Notify({Title = "Error", Content = "Could not find your own plate!", Duration = 4})
            return
        end

        local StampEvent = ReplicatedStorage:FindFirstChild("Remotes")
            and ReplicatedStorage.Remotes:FindFirstChild("StampAsset")
        if not StampEvent then
            Rayfield:Notify({Title = "Error", Content = "StampAsset remote not found!", Duration = 3})
            return
        end

        task.spawn(function()

            -- ── Translation delta ────────────────────────────────────────────────
            local srcPivot = sourcePlate:GetPivot()
            local myPivot  = myPlate:GetPivot()
            local deltaX   = myPivot.X - srcPivot.X
            local deltaY   = myPivot.Y - srcPivot.Y
            local deltaZ   = myPivot.Z - srcPivot.Z
            print(string.format("Pivot delta: (%.3f, %.3f, %.3f)", deltaX, deltaY, deltaZ))

            -- ── Scan source blocks ───────────────────────────────────────────────
            local validPartsData = {}

            for _, model in ipairs(sourcePlate.ActiveParts:GetChildren()) do
                if model:IsA("Model") then
                    local lookupName = string.lower(model.Name)
                    local blockInfo  = BlockDatabase[lookupName]
                    local assetId    = blockInfo and blockInfo.AssetId
                        or (model:FindFirstChild("AssetId") and model.AssetId.Value)
                    local uuid = blockInfo and blockInfo.Uuid
                        or ("{" .. string.lower(string.format(
                            "%08x-%04x-%04x-%04x-%012x",
                            math.random(0, 0xFFFFFFFF),
                            math.random(0, 0xFFFF),
                            math.random(0, 0xFFFF),
                            math.random(0, 0xFFFF),
                            math.random(0, 0xFFFFFFFFFFFF)
                        )) .. "}")
                    local placementCFrameVal = model:FindFirstChild("PlacementCFrame")
                    local rotVal = model:FindFirstChild("Rotation")
                        or model:FindFirstChild("RotationIndex")
                    local rotationIndex = (rotVal and rotVal:IsA("IntValue")) and rotVal.Value or 0

                    if assetId and placementCFrameVal then
                        local srcCF = placementCFrameVal.Value
                        local sx, sy, sz = getModelSize(model)

                        local targetCF = CFrame.new(
                            srcCF.X + deltaX,
                            srcCF.Y + deltaY,
                            srcCF.Z + deltaZ,
                            srcCF.XVector.X, srcCF.YVector.X, srcCF.ZVector.X,
                            srcCF.XVector.Y, srcCF.YVector.Y, srcCF.ZVector.Y,
                            srcCF.XVector.Z, srcCF.YVector.Z, srcCF.ZVector.Z
                        )

                        table.insert(validPartsData, {
                            AssetId       = assetId,
                            Uuid          = uuid,
                            TargetCF      = targetCF,
                            RotationIndex = rotationIndex,
                            SizeX         = sx,
                            SizeY         = sy,
                            SizeZ         = sz,
                        })
                    end
                end
            end

            if #validPartsData == 0 then
                Rayfield:Notify({Title = "Error", Content = "No valid parts found to copy!", Duration = 3})
                return
            end

            print(string.format("Total blocks: %d", #validPartsData))

            -- ── Seed floor occupancy with full footprint ─────────────────────────
            local occupied = {}
            local myBase   = getLargestBase(myPlate)
            local floorY   = myPivot.Y

            if myBase then
                local topY = myBase.Position.Y + myBase.Size.Y / 2
                if topY > floorY then floorY = topY end
                -- Mark the entire floor surface as occupied
                markFootprint(
                    myBase.Position.X, floorY, myBase.Position.Z,
                    myBase.Size.X, GRID, myBase.Size.Z,
                    occupied
                )
                -- One layer below too so bottom-face checks find it
                markFootprint(
                    myBase.Position.X, floorY - GRID, myBase.Position.Z,
                    myBase.Size.X, GRID, myBase.Size.Z,
                    occupied
                )
                print(string.format("Floor seeded Y=%.2f | base %.0fx%.0f",
                    floorY, myBase.Size.X, myBase.Size.Z))
            else
                -- Fallback: wide band at pivot
                for ix = -60, 60, GRID do
                    for iz = -60, 60, GRID do
                        occupied[occupancyKey(myPivot.X + ix, myPivot.Y, myPivot.Z + iz)] = true
                        occupied[occupancyKey(myPivot.X + ix, myPivot.Y - GRID, myPivot.Z + iz)] = true
                    end
                end
                print("Floor seed fallback: pivot band")
            end

            -- ── Connectivity-first BFS with footprint-aware adjacency ────────────
            local STAMP_DELAY  = 0.08   -- remote rate limit
            local PASS_PAUSE   = 0.5    -- server weld settle time between passes

            local remaining = {}
            for _, d in ipairs(validPartsData) do table.insert(remaining, d) end

            local count           = 0
            local passNum         = 0
            local stuckCount      = 0
            local MAX_STUCK       = 3   -- force-stamp after this many zero-progress passes

            while #remaining > 0 do
                passNum = passNum + 1

                local ready    = {}
                local deferred = {}

                for _, data in ipairs(remaining) do
                    local tcf = data.TargetCF
                    if hasNeighbor(tcf.X, tcf.Y, tcf.Z,
                                   data.SizeX, data.SizeY, data.SizeZ,
                                   occupied) then
                        table.insert(ready, data)
                    else
                        table.insert(deferred, data)
                    end
                end

                if #ready == 0 then
                    stuckCount = stuckCount + 1
                    print(string.format("Pass %d: no ready blocks (stuck %d/%d)",
                        passNum, stuckCount, MAX_STUCK))

                    if stuckCount >= MAX_STUCK then
                        -- Force-stamp ALL remaining as disconnected islands
                        print(string.format("Force-stamping %d disconnected blocks", #deferred))
                        for _, data in ipairs(deferred) do
                            pcall(function()
                                StampEvent:InvokeServer(
                                    data.AssetId,
                                    data.TargetCF,
                                    data.Uuid,
                                    {},
                                    data.RotationIndex
                                )
                            end)
                            local tcf = data.TargetCF
                            markFootprint(tcf.X, tcf.Y, tcf.Z,
                                data.SizeX, data.SizeY, data.SizeZ, occupied)
                            count = count + 1
                            task.wait(STAMP_DELAY)
                        end
                        deferred = {}
                        stuckCount = 0
                    end

                    remaining = deferred
                    task.wait(PASS_PAUSE)
                    continue
                end

                stuckCount = 0  -- made progress, reset stuck counter

                -- Most neighbors first, lowest Y as tiebreak
                table.sort(ready, function(a, b)
                    local na = neighborCount(a.TargetCF.X, a.TargetCF.Y, a.TargetCF.Z,
                                            a.SizeX, a.SizeY, a.SizeZ, occupied)
                    local nb = neighborCount(b.TargetCF.X, b.TargetCF.Y, b.TargetCF.Z,
                                            b.SizeX, b.SizeY, b.SizeZ, occupied)
                    if na ~= nb then return na > nb end
                    return a.TargetCF.Y < b.TargetCF.Y
                end)

                for _, data in ipairs(ready) do
                    pcall(function()
                        StampEvent:InvokeServer(
                            data.AssetId,
                            data.TargetCF,
                            data.Uuid,
                            {},
                            data.RotationIndex
                        )
                    end)
                    local tcf = data.TargetCF
                    markFootprint(tcf.X, tcf.Y, tcf.Z,
                        data.SizeX, data.SizeY, data.SizeZ, occupied)
                    count = count + 1
                    task.wait(STAMP_DELAY)
                end

                print(string.format("Pass %d: stamped %d | remaining %d",
                    passNum, #ready, #deferred))

                remaining = deferred
                if #remaining > 0 then
                    task.wait(PASS_PAUSE)
                end
            end

            print("--- Build Complete. Total:", count, "---")
            Rayfield:Notify({
                Title   = "Success",
                Content = "Build complete! " .. count .. " blocks placed.",
                Duration = 4
            })
        end)
    end,
})

