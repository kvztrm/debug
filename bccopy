Tab:CreateButton({
    Name = "Mirror & Build (Pivot-Delta, Layer+Center-Out)",
    Callback = function()
        if not selectedPlotName or selectedPlotName == "Scanning..." or selectedPlotName == "No Available Plots" then
            Rayfield:Notify({Title = "Error", Content = "Please select a valid plot first!", Duration = 3})
            return
        end

        local plateNum   = selectedPlotName:match("Plate%s*(%d)")
        local sourcePlate = plateNum and Workspace:FindFirstChild("Plates") and Workspace.Plates:FindFirstChild("Plate" .. plateNum)
        local myPlate    = getMyPlate()

        if not sourcePlate or not sourcePlate:FindFirstChild("ActiveParts") then
            Rayfield:Notify({Title = "Error", Content = "Source ActiveParts not found!", Duration = 3})
            return
        end
        if not myPlate then
            Rayfield:Notify({Title = "Error", Content = "Could not find your own plate!", Duration = 4})
            return
        end

        local StampEvent = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("StampAsset")
        if not StampEvent then
            Rayfield:Notify({Title = "Error", Content = "StampAsset remote not found!", Duration = 3})
            return
        end

        task.spawn(function()

            -- ── Pivot anchors — this is the coordinate origin PlacementCFrame uses ──
            local srcPivot = sourcePlate:GetPivot()
            local myPivot  = myPlate:GetPivot()

            local srcPivotX = srcPivot.X
            local srcPivotZ = srcPivot.Z
            local srcPivotY = srcPivot.Y

            local myPivotX  = myPivot.X
            local myPivotZ  = myPivot.Z
            local myPivotY  = myPivot.Y

            print(string.format("Source pivot: (%.3f, %.3f, %.3f)", srcPivotX, srcPivotY, srcPivotZ))
            print(string.format("Target pivot: (%.3f, %.3f, %.3f)", myPivotX,  myPivotY,  myPivotZ))

            -- ── Scan source ActiveParts ──────────────────────────────────────────
            local validPartsData = {}

            for _, model in ipairs(sourcePlate.ActiveParts:GetChildren()) do
                if model:IsA("Model") then
                    local lookupName = string.lower(model.Name)
                    local blockInfo  = BlockDatabase[lookupName]
                    local assetId    = blockInfo and blockInfo.AssetId
                        or (model:FindFirstChild("AssetId") and model.AssetId.Value)
                    local uuid       = blockInfo and blockInfo.Uuid
                        or ("{" .. string.lower(string.format(
                            "%08x-%04x-%04x-%04x-%012x",
                            math.random(0, 0xFFFFFFFF),
                            math.random(0, 0xFFFF),
                            math.random(0, 0xFFFF),
                            math.random(0, 0xFFFF),
                            math.random(0, 0xFFFFFFFFFFFF)
                        )) .. "}")
                    local placementCFrameVal = model:FindFirstChild("PlacementCFrame")

                    if assetId and placementCFrameVal then
                        local cf = placementCFrameVal.Value
                        table.insert(validPartsData, {AssetId = assetId, Uuid = uuid, CFrame = cf})
                    end
                end
            end

            if #validPartsData == 0 then
                Rayfield:Notify({Title = "Error", Content = "No valid parts found to copy!", Duration = 3})
                return
            end

            -- ── Group into Y layers, sort each layer center-outward ──────────────
            local layers = groupIntoLayers(validPartsData, srcPivotX, srcPivotZ)
            local totalBlocks = #validPartsData
            print(string.format("Layers detected: %d | Total blocks: %d", #layers, totalBlocks))

            -- Log first 3 layer Y values and counts so we can verify grouping
            for i = 1, math.min(3, #layers) do
                local ly = layers[i][1].CFrame.Y
                print(string.format("  Layer %d: Y=%.3f, blocks=%d", i, ly, #layers[i]))
            end

            local LAYER_PAUSE = 0.4
            local count = 0

            -- ── Stamp layer by layer, center-outward within each layer ───────────
            for layerIdx, layer in ipairs(layers) do
                for _, data in ipairs(layer) do
                    local cf = data.CFrame

                    -- Exact delta from source pivot — no ratio, no stretch
                    local deltaX = cf.X - srcPivotX
                    local deltaZ = cf.Z - srcPivotZ
                    local targetX = myPivotX + deltaX
                    local targetZ = myPivotZ + deltaZ

                    -- Y relative to source pivot Y, re-anchored to target pivot Y
                    local relativeY = cf.Y - srcPivotY
                    local targetY   = myPivotY + relativeY

                    local local_xx, local_yx, local_zx,
                          local_xy, local_yy, local_zy,
                          local_xz, local_yz, local_zz

                    _, _, _,
                    local_xx, local_yx, local_zx,
                    local_xy, local_yy, local_zy,
                    local_xz, local_yz, local_zz = cf:GetComponents()

                    local translatedCF = CFrame.new(
                        targetX, targetY, targetZ,
                        local_xx, local_yx, local_zx,
                        local_xy, local_yy, local_zy,
                        local_xz, local_yz, local_zz
                    )

                    pcall(function()
                        StampEvent:InvokeServer(
                            data.AssetId,
                            translatedCF,
                            data.Uuid,
                            {},
                            0
                        )
                    end)

                    count = count + 1
                    task.wait(0.08)
                end

                -- Pause between layers so server anchors current layer
                -- before the next one arrives
                if layerIdx < #layers then
                    task.wait(LAYER_PAUSE)
                end
            end

            print("--- Build Complete. Total:", count, "---")
            Rayfield:Notify({
                Title   = "Success",
                Content = "Build complete! " .. count .. " blocks placed.",
                Duration = 4
            })
        end)
    end,
})

-- Dropdown refresh loop
task.spawn(function()
    while true do
        local newPlotOptions = {}
        if Workspace:FindFirstChild("Plates") then
            for i = 1, 9 do
                local plate = Workspace.Plates:FindFirstChild("Plate" .. i)
                if plate then
                    local ownerVal    = plate:FindFirstChild("Owner") and plate.Owner.Value
                    local ownerString = (ownerVal and ownerVal ~= "") and tostring(ownerVal) or "Nobody"
                    if ownerString ~= LocalPlayer.Name then
                        table.insert(newPlotOptions, "Plate " .. i .. " - " .. ownerString)
                    end
                end
            end
        end

        if #newPlotOptions == 0 then
            newPlotOptions = {"No Available Plots"}
        end

        PlotDropdown:Refresh(newPlotOptions)
        task.wait(3)
    end
end)
