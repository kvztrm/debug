Tab:CreateButton({
    Name = "Mirror & Build (Rotation Index + BFS)",
    Callback = function()
        if not selectedPlotName or selectedPlotName == "Scanning..." or selectedPlotName == "No Available Plots" then
            Rayfield:Notify({Title = "Error", Content = "Please select a valid plot first!", Duration = 3})
            return
        end

        local plateNum    = selectedPlotName:match("Plate%s*(%d)")
        local sourcePlate = plateNum and Workspace:FindFirstChild("Plates")
            and Workspace.Plates:FindFirstChild("Plate" .. plateNum)
        local myPlate     = getMyPlate()

        if not sourcePlate or not sourcePlate:FindFirstChild("ActiveParts") then
            Rayfield:Notify({Title = "Error", Content = "Source ActiveParts not found!", Duration = 3})
            return
        end
        if not myPlate then
            Rayfield:Notify({Title = "Error", Content = "Could not find your own plate!", Duration = 4})
            return
        end

        local StampEvent = ReplicatedStorage:FindFirstChild("Remotes")
            and ReplicatedStorage.Remotes:FindFirstChild("StampAsset")
        if not StampEvent then
            Rayfield:Notify({Title = "Error", Content = "StampAsset remote not found!", Duration = 3})
            return
        end

        task.spawn(function()

            -- ── Translation delta: source pivot → target pivot ────────────────────
            -- PlacementCFrame positions are raw world space.
            -- We shift each one by the vector from source plate pivot to target plate pivot.
            local srcPivot = sourcePlate:GetPivot()
            local myPivot  = myPlate:GetPivot()

            local deltaX = myPivot.X - srcPivot.X
            local deltaY = myPivot.Y - srcPivot.Y
            local deltaZ = myPivot.Z - srcPivot.Z

            print(string.format("Pivot delta: (%.3f, %.3f, %.3f)", deltaX, deltaY, deltaZ))

            -- ── Scan source ActiveParts ──────────────────────────────────────────
            local validPartsData = {}

            for _, model in ipairs(sourcePlate.ActiveParts:GetChildren()) do
                if model:IsA("Model") then
                    local lookupName = string.lower(model.Name)
                    local blockInfo  = BlockDatabase[lookupName]
                    local assetId    = blockInfo and blockInfo.AssetId
                        or (model:FindFirstChild("AssetId") and model.AssetId.Value)
                    local uuid       = blockInfo and blockInfo.Uuid
                        or ("{" .. string.lower(string.format(
                            "%08x-%04x-%04x-%04x-%012x",
                            math.random(0, 0xFFFFFFFF),
                            math.random(0, 0xFFFF),
                            math.random(0, 0xFFFF),
                            math.random(0, 0xFFFF),
                            math.random(0, 0xFFFFFFFFFFFF)
                        )) .. "}")
                    local placementCFrameVal = model:FindFirstChild("PlacementCFrame")

                    -- Read the rotation index the server actually uses.
                    -- Cobalt shows it as the last InvokeServer argument.
                    -- The game stores it on the model as an IntValue named "Rotation"
                    -- (or "RotationIndex" — check both).
                    local rotVal = model:FindFirstChild("Rotation")
                        or model:FindFirstChild("RotationIndex")
                    local rotationIndex = (rotVal and rotVal:IsA("IntValue")) and rotVal.Value or 0

                    if assetId and placementCFrameVal then
                        local srcCF = placementCFrameVal.Value

                        -- Translate world position by pivot delta.
                        -- CFrame rotation matrix is sent as-is but server overwrites
                        -- it using rotationIndex — so we preserve the source matrix
                        -- for position integrity but rotationIndex is what actually rotates.
                        local targetCF = CFrame.new(
                            srcCF.X + deltaX,
                            srcCF.Y + deltaY,
                            srcCF.Z + deltaZ,
                            srcCF.XVector.X, srcCF.YVector.X, srcCF.ZVector.X,
                            srcCF.XVector.Y, srcCF.YVector.Y, srcCF.ZVector.Y,
                            srcCF.XVector.Z, srcCF.YVector.Z, srcCF.ZVector.Z
                        )

                        table.insert(validPartsData, {
                            AssetId       = assetId,
                            Uuid          = uuid,
                            TargetCF      = targetCF,
                            RotationIndex = rotationIndex,
                        })
                    end
                end
            end

            if #validPartsData == 0 then
                Rayfield:Notify({Title = "Error", Content = "No valid parts found to copy!", Duration = 3})
                return
            end

            print(string.format("Total blocks to place: %d", #validPartsData))

            -- Log first block to verify rotation index is being read
            if validPartsData[1] then
                local d = validPartsData[1]
                print(string.format("Sample block — assetId: %d | rotIndex: %d | pos: (%.2f, %.2f, %.2f)",
                    d.AssetId, d.RotationIndex, d.TargetCF.X, d.TargetCF.Y, d.TargetCF.Z))
            end

            -- ── Seed occupancy grid from target plate floor ──────────────────────
            local occupied = {}
            local myBase   = getLargestBase(myPlate)
            local floorY   = myPivot.Y

            if myBase then
                local topY = myBase.Position.Y + myBase.Size.Y / 2
                if topY > floorY then floorY = topY end

                local bx = myBase.Position.X
                local bz = myBase.Position.Z
                local hx = math.ceil(myBase.Size.X / 2)
                local hz = math.ceil(myBase.Size.Z / 2)

                for ix = -hx, hx, GRID do
                    for iz = -hz, hz, GRID do
                        -- Seed floor surface and one cell below
                        occupied[occupancyKey(bx + ix, floorY,        bz + iz)] = true
                        occupied[occupancyKey(bx + ix, floorY - GRID, bz + iz)] = true
                    end
                end
                print(string.format("Floor seeded at Y=%.2f over %.0fx%.0f base",
                    floorY, myBase.Size.X, myBase.Size.Z))
            else
                -- Fallback: seed a wide band at pivot Y
                for ix = -60, 60, GRID do
                    for iz = -60, 60, GRID do
                        occupied[occupancyKey(myPivot.X + ix, myPivot.Y,        myPivot.Z + iz)] = true
                        occupied[occupancyKey(myPivot.X + ix, myPivot.Y - GRID, myPivot.Z + iz)] = true
                    end
                end
                print("Floor seed fallback: wide band at pivot Y")
            end

            -- ── BFS connectivity stamp ───────────────────────────────────────────
            local remaining  = {}
            for _, d in ipairs(validPartsData) do
                table.insert(remaining, d)
            end

            local count      = 0
            local passNum    = 0
            local MAX_PASSES = 60
            local PASS_PAUSE = 0.15

            while #remaining > 0 and passNum < MAX_PASSES do
                passNum = passNum + 1
                local deferred   = {}
                local passPlaced = 0

                -- Lowest Y first within each pass
                table.sort(remaining, function(a, b)
                    return a.TargetCF.Y < b.TargetCF.Y
                end)

                for _, data in ipairs(remaining) do
                    local tcf = data.TargetCF
                    local tx, ty, tz = tcf.X, tcf.Y, tcf.Z

                    if hasNeighbor(tx, ty, tz, occupied) then
                        pcall(function()
                            StampEvent:InvokeServer(
                                data.AssetId,
                                tcf,
                                data.Uuid,
                                {},
                                data.RotationIndex
                            )
                        end)

                        -- Mark occupied at this position and directly above/below
                        -- so blocks that sit flush on top register as connected
                        occupied[occupancyKey(tx, ty,        tz)] = true
                        occupied[occupancyKey(tx, ty + GRID, tz)] = true
                        occupied[occupancyKey(tx, ty - GRID, tz)] = true

                        count      = count + 1
                        passPlaced = passPlaced + 1
                        task.wait(0.08)
                    else
                        table.insert(deferred, data)
                    end
                end

                print(string.format("Pass %d: placed %d, deferred %d", passNum, passPlaced, #deferred))

                if passPlaced == 0 then
                    -- Structurally disconnected remainder — force stamp so nothing is lost
                    print(string.format("Force-stamping %d disconnected blocks", #deferred))
                    for _, data in ipairs(deferred) do
                        pcall(function()
                            StampEvent:InvokeServer(
                                data.AssetId,
                                data.TargetCF,
                                data.Uuid,
                                {},
                                data.RotationIndex
                            )
                        end)
                        count = count + 1
                        task.wait(0.08)
                    end
                    deferred = {}
                end

                remaining = deferred
                if #remaining > 0 then
                    task.wait(PASS_PAUSE)
                end
            end

            print("--- Build Complete. Total:", count, "---")
            Rayfield:Notify({
                Title   = "Success",
                Content = "Build complete! " .. count .. " blocks placed.",
                Duration = 4
            })
        end)
    end,
})

-- Dropdown refresh loop
task.spawn(function()
    while true do
        local newPlotOptions = {}
        if Workspace:FindFirstChild("Plates") then
            for i = 1, 9 do
                local plate = Workspace.Plates:FindFirstChild("Plate" .. i)
                if plate then
                    local ownerVal    = plate:FindFirstChild("Owner") and plate.Owner.Value
                    local ownerString = (ownerVal and ownerVal ~= "") and tostring(ownerVal) or "Nobody"
                    if ownerString ~= LocalPlayer.Name then
                        table.insert(newPlotOptions, "Plate " .. i .. " - " .. ownerString)
                    end
                end
            end
        end

        if #newPlotOptions == 0 then
            newPlotOptions = {"No Available Plots"}
        end

        PlotDropdown:Refresh(newPlotOptions)
        task.wait(3)
    end
end)
