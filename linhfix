-- Secret Island Jail (fixed)
local jailRunning = false
local SecretIslandCFrame = CFrame.new(-21.291458129882812, 0.3889467120170593, -5553.3359375)
local JailStampAsset = game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("StampAsset")
local JailDeleteAsset = game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("DeleteAsset")
local JailPlates = workspace:WaitForChild("Plates")

local function GetJailPlate()
    for _, Plate in pairs(JailPlates:GetChildren()) do
        if Plate:FindFirstChild("Owner") and Plate.Owner.Value == LocalPlayer then
            return Plate:FindFirstChild("Plate"), Plate:FindFirstChild("ActiveParts")
        end
    end
    return nil, nil
end

local function CleanJailStamps(ActiveParts)
    if not ActiveParts then return end
    for _, part in ipairs(ActiveParts:GetChildren()) do
        if part.Name == "Trapdoor - Grass" or part.Name == "Stone - Block" then
            task.spawn(function()
                pcall(function() JailDeleteAsset:InvokeServer(part) end)
            end)
        end
    end
end

local function JailLoop()
    while jailRunning do
        local LPlate, ActiveParts = GetJailPlate()
        if LPlate then
            for _, plr in pairs(Players:GetPlayers()) do
                if plr ~= LocalPlayer and plr.Character then
                    local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        task.spawn(function()
                            pcall(function()
                                JailStampAsset:InvokeServer(
                                    41324912,
                                    SecretIslandCFrame,
                                    "{99ab22df-ca29-4143-a2fd-0a1b79db78c2}",
                                    {hrp},
                                    0
                                )
                            end)
                            task.wait(0.3)
                            CleanJailStamps(ActiveParts)
                        end)
                    end
                end
            end
        end
        task.wait(0.5)
    end
end

