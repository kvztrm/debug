local antiTrapConnections = {}
local antiTrapOriginalStates = {}
local antiTrapEnabled = false

local function makeSafe(part)
    if part:IsA("BasePart") then
        if not antiTrapOriginalStates[part] then
            antiTrapOriginalStates[part] = {CanTouch = part.CanTouch, CanCollide = part.CanCollide}
        end
        part.CanTouch = false
        part.CanCollide = false
    end
end

local function restoreStates()
    for part, state in pairs(antiTrapOriginalStates) do
        if part and part:IsDescendantOf(workspace) then
            part.CanTouch = state.CanTouch
            part.CanCollide = state.CanCollide
        end
    end
    antiTrapOriginalStates = {}
end

local function handlePart(part)
    local name = part.Name:lower()
    if string.find(name, "laser") or string.find(name, "spike") or string.find(name, "fire") or string.find(name, "z#4fzo0") then
        makeSafe(part)
    end
end

local function startAntiTrap()
    for _, plate in pairs(workspace.Plates:GetChildren()) do
        for _, obj in ipairs(plate:GetDescendants()) do handlePart(obj) end
        local conn = plate.DescendantAdded:Connect(function(obj)
            if antiTrapEnabled then handlePart(obj) end
        end)
        table.insert(antiTrapConnections, conn)
    end
    local conn = workspace.Plates.ChildAdded:Connect(function(plate)
        for _, obj in ipairs(plate:GetDescendants()) do handlePart(obj) end
        local sub = plate.DescendantAdded:Connect(function(obj)
            if antiTrapEnabled then handlePart(obj) end
        end)
        table.insert(antiTrapConnections, sub)
    end)
    table.insert(antiTrapConnections, conn)
end

local function stopAntiTrap()
    for _, conn in ipairs(antiTrapConnections) do
        if typeof(conn) == "RBXScriptConnection" then conn:Disconnect() end
    end
    antiTrapConnections = {}
    restoreStates()
end

