local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
local basementStorages = workspace:FindFirstChild("BasementStorages")
if not basementStorages then warn("BasementStorages not found") return end

local handles = {}
for _, child in ipairs(basementStorages:GetChildren()) do
    local door = child:FindFirstChild("Door")
    if door then
        local handle = door:FindFirstChild("Handle")
        if handle and handle:IsA("BasePart") then table.insert(handles, handle) end
    end
end
if #handles == 0 then warn("No handles found") return end
print("Found " .. #handles .. " handles. Running...")

local function getMobPosition(mob)
    return mob.PrimaryPart and mob.PrimaryPart.Position or mob:FindFirstChildWhichIsA("BasePart") and mob:FindFirstChildWhichIsA("BasePart").Position
end

local function getLootPosition(loot)
    return loot.PrimaryPart and loot.PrimaryPart.Position or loot:FindFirstChildWhichIsA("BasePart") or loot:FindFirstChild("Mesh") and loot.Mesh.Position or loot:FindFirstChildWhichIsA("BasePart") and loot:FindFirstChildWhichIsA("BasePart").Position
end

local function findPrompt(obj)
    if obj:IsA("ProximityPrompt") then return obj end
    for _, c in ipairs(obj:GetChildren()) do
        local found = findPrompt(c)
        if found then return found end
    end
    return nil
end

local function tweenToPos(targetPos)
    local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local dist = (targetPos - root.Position).Magnitude
    local dur = dist / 100
    local info = TweenInfo.new(dur, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut)
    local tween = TweenService:Create(root, info, {CFrame = CFrame.new(targetPos)})
    tween:Play()
    tween.Completed:Wait()
end

local function collectLootItem(loot, lootFolder)
    local prompt = findPrompt(loot)
    if not prompt then return false end
    for _ = 1, 5 do
        prompt:InputHoldBegin()
        task.wait(prompt.HoldDuration + 0.1)
        prompt:InputHoldEnd()
        task.wait(0.05)
        if not loot:IsDescendantOf(lootFolder) then return true end
    end
    return false
end

local mobsFolder = workspace:FindFirstChild("Mobs")
local npcModel = workspace.NPC and workspace.NPC:FindFirstChild("Storage Collector")
local sellEvent = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("RemoteEvent")
if not sellEvent then warn("RemoteEvent not found") end

local storages = workspace:FindFirstChild("Storages")
local safeModel = storages and storages:GetChildren()[2] and storages:GetChildren()[2]:FindFirstChild("Contents") and storages:GetChildren()[2].Contents:FindFirstChild("Objects") and storages:GetChildren()[2].Contents.Objects:FindFirstChild("Safe")
local safeBox = safeModel and safeModel:FindFirstChild("Base") and safeModel.Base:FindFirstChild("Box")
local backpack = player:WaitForChild("Backpack")

local function sellAll()
    if not npcModel or not sellEvent then return end
    local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local special = backpack:FindFirstChild("Shotgun Ammo Pack")
    local toSell = {}
    for _, tool in ipairs(backpack:GetChildren()) do
        if tool:IsA("Tool") and tool ~= special then table.insert(toSell, tool) end
    end
    if #toSell > 0 then
        print("Selling " .. #toSell .. " items...")
        root.CFrame = CFrame.new(-677, 10, 12)
        task.wait(0.5)
        for _, tool in ipairs(toSell) do
            sellEvent:FireServer("SellItem", tool.Name, npcModel)
            print("Sold: " .. tool.Name)
        end
    end
end

local function storeSpecial()
    local special = backpack:FindFirstChild("Shotgun Ammo Pack")
    if special and safeBox and safeModel then
        local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        if not root then return end
        local humanoid = player.Character:FindFirstChild("Humanoid")
        if not humanoid then return end
        print("Storing Shotgun Ammo Pack...")
        local boxPos = safeBox.Position + Vector3.new(0, 2, 0)
        root.CFrame = CFrame.new(boxPos)
        task.wait(0.3)
        humanoid:EquipTool(special)
        task.wait(0.5)
        sellEvent:FireServer("StoreBank", "5", "", safeModel)
        print("Stored!")
    end
end

while true do
    local char = player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Humanoid").Health <= 0 then
        player.CharacterAdded:Wait()
        task.wait(1)
    end
    char = player.Character
    local root = char:FindFirstChild("HumanoidRootPart")
    local humanoid = char:FindFirstChild("Humanoid")
    if not root or not humanoid then continue end

    sellAll()
    local opened = {}
    for _ = 1, #handles do table.insert(opened, false) end

    for i, handle in ipairs(handles) do
        if opened[i] then continue end
        if not player.Character or player.Character:FindFirstChild("Humanoid").Health <= 0 then break end

        local skip = false
        if mobsFolder then
            for _, mob in ipairs(mobsFolder:GetChildren()) do
                local mobPos = getMobPosition(mob)
                if mobPos and (mobPos - handle.Position).Magnitude <= 80 then skip = true; break end
            end
        end
        if skip then continue end

        root.CFrame = CFrame.new(handle.Position + Vector3.new(0, 2, 0))
        task.wait(0.5)

        local doorPrompt = handle:FindFirstChild("ProximityPrompt")
        if doorPrompt then
            doorPrompt:InputHoldBegin()
            task.wait(doorPrompt.HoldDuration + 0.1)
            doorPrompt:InputHoldEnd()
        end
        task.wait(1.5)

        local lootFolder = handle.Parent.Parent and handle.Parent.Parent:FindFirstChild("Contents") and handle.Parent.Parent.Contents:FindFirstChild("Loot")
        if lootFolder then
            local lootItems = lootFolder:GetChildren()
            table.sort(lootItems, function(a, b) 
                local pa = getLootPosition(a)
                local pb = getLootPosition(b)
                return pa and pb and pa.Y > pb.Y
            end)

            for _, loot in ipairs(lootItems) do
                if not player.Character or player.Character:FindFirstChild("Humanoid").Health <= 0 then break end
                local lootPos = getLootPosition(loot)
                if lootPos then
                    tweenToPos(lootPos + Vector3.new(0, 0.5, 0))
                    if collectLootItem(loot, lootFolder) then
                        print("Collected: " .. loot.Name)
                    end
                    task.wait(0.2)
                end
            end
        end

        if lootFolder then sellAll(); storeSpecial() end
        opened[i] = true
        task.wait(0.2)
    end
end
