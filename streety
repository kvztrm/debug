local player = game.Players.LocalPlayer
local toggle = false
local scriptRunning = true
local safePosition = Vector3.new(630, -310, -20)

local function getCharacter()
    local char = player.Character or player.CharacterAdded:Wait()
    local root = char:WaitForChild("HumanoidRootPart", 5)
    local hum = char:WaitForChild("Humanoid", 5)
    return char, root, hum
end

local character, root, humanoid = getCharacter()

local function cleanup()
    if root then root.Anchored = false end
    print("🛑 Script killed and cleaned up.")
end

local function lookAt(targetPos)
    if root then
        local direction = (targetPos - root.Position).Unit
        root.CFrame = CFrame.lookAt(root.Position, root.Position + direction)
    end
end

local function getPosition(obj)
    if obj:IsA("BasePart") then
        return obj.Position
    elseif obj.WorldPivot then
        return obj.WorldPivot.Position
    elseif obj:IsA("Model") then
        return obj:GetPivot().Position
    else
        return obj.Position or Vector3.new(0,0,0)
    end
end

local function firePrompt(prompt, targetPos)
    if not prompt or not prompt:IsA("ProximityPrompt") then return end
    
    lookAt(targetPos)           -- Look at the object
    task.wait(0.2)              -- Small delay to register look direction
    
    prompt:InputHoldBegin()
    task.wait(0.1)
    prompt:InputHoldEnd()
    
    task.wait(0.5)              -- 0.5 second cooldown after each fire
end

local function teleportTo(pos)
    if root then
        root.CFrame = CFrame.new(pos)
    end
end

local function mainLoop()
    while toggle and scriptRunning do
        character, root, humanoid = getCharacter()
        
        local storages = workspace:FindFirstChild("BasementStorages")
        if not storages then
            print("❌ BasementStorages folder not found!")
            task.wait(2)
            continue
        end
        
        for _, storage in ipairs(storages:GetChildren()) do
            if not (toggle and scriptRunning) then break end
            
            if humanoid.Health < 20 then
                print("Low health - going to safe spot")
                teleportTo(safePosition)
                if root then root.Anchored = true end
                task.wait(5)
                continue
            end
            
            -- Door handling
            local door = storage:FindFirstChild("Door", true)
            local handle = door and door:FindFirstChild("Handle")
            
            if handle then
                print("Processing:", storage.Name)
                
                -- Under handle + anchor
                local underPos = handle.Position - Vector3.new(0, 3, 0)
                teleportTo(underPos)
                if root then root.Anchored = true end
                task.wait(2)
                if root then root.Anchored = false end
                
                -- Direct to handle
                teleportTo(handle.Position)
                task.wait(0.4)
                
                local prompt = handle:FindFirstChildOfClass("ProximityPrompt")
                if prompt then
                    firePrompt(prompt, handle.Position)
                end
            end
            
            -- Loot
            local contents = storage:FindFirstChild("Contents")
            if contents then
                for _, obj in ipairs(contents:GetDescendants()) do
                    local prompt = obj:FindFirstChildOfClass("ProximityPrompt")
                    if prompt then
                        local pos = getPosition(obj)
                        teleportTo(pos)
                        task.wait(0.4)
                        firePrompt(prompt, pos)
                    end
                end
            end
        end
        task.wait(0.5)
    end
end

game:GetService("UserInputService").InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.Q then
        toggle = not toggle
        print(toggle and "✅ ENABLED (Q = toggle | X = kill)" or "⏸️ PAUSED")
        if toggle then spawn(mainLoop) end
    elseif input.KeyCode == Enum.KeyCode.X then
        toggle = false
        scriptRunning = false
        cleanup()
    end
end)

print("✅ Script updated with look-at + 0.5s cooldown. Press Q to start")
